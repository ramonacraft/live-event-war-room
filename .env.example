# Live Event War Room — default is no secrets.
# Leave everything commented out. The app works without a .env file.
#
# Optional only: override where the Release Gate strip reads status from.
# Local npm run dev already proxies /release-gate-api → Release Gate Lab.
# VITE_RELEASE_GATE_API_URL=https://release-gate-lab.vercel.app/api/runs
#
# Never put PATs, API keys, or passwords here. Azure credentials belong only
# on Release Gate Lab’s host (e.g. Vercel env), not in this project.
